<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sign_send_view_form" model="ir.ui.view">
        <field name="name">sign.methode.send.form</field>
        <field name="model">sign.methode.send</field>
        <field name="arch" type="xml">
            <form class="o_sign_methode_send">
                <field name="res_model" invisible="1" />
                <field name="res_id" invisible="1" />
                <field name="has_record_document" invisible="1" />
                <div class="o_sign_methode_send_doc mb-3">
                    <label for="name" class="d-block fw-bold mb-1" />
                    <field name="name" class="w-100 fs-5" placeholder="e.g. Partnership agreement 2026" />
                    <div class="text-muted small mt-2" invisible="not has_record_document">
                        <i class="fa fa-file-pdf-o me-1" />The record's own PDF will be signed.
                    </div>
                    <div class="mt-2" invisible="has_record_document">
                        <field name="document" filename="document_name" required="not has_record_document and not template_id" />
                        <field name="document_name" invisible="1" />
                    </div>
                </div>
                <field name="signer_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" widget="handle" />
                        <field name="partner_id" required="1" context="{'show_email': True}" options="{'no_quick_create': False}" />
                        <field name="email" required="1" />
                        <field name="phone" optional="hide" />
                        <field name="role_id" optional="show" />
                        <field name="otp_channel" optional="hide" placeholder="Default" />
                    </list>
                </field>
                <field name="message" placeholder="Add a message for the signers (optional)…" />
                <details class="mt-3 o_sign_methode_send_options">
                    <summary class="text-muted">Options</summary>
                    <group class="mt-2">
                        <group>
                            <field name="template_id" placeholder="Simple: signature page at the end" />
                            <field name="sequential" />
                        </group>
                        <group>
                            <field name="otp_channel" />
                            <field name="expire_on" />
                            <field name="reminder_days" />
                        </group>
                    </group>
                </details>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary" data-hotkey="q" />
                    <button name="action_save_draft" type="object" string="Save as draft" />
                    <button special="cancel" string="Discard" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
