#. module: sign_methode
#: model:mail.template,body_html:sign_methode.mail_template_invite
msgid ""
"<div style=\"font-family: Nunito, Helvetica, Arial, sans-serif; color: "
"#111827; max-width: 560px;\">\n"
"    <p style=\"margin: 0 0 16px;\">Hello <t t-out=\"object.name or "
"''\">Alice</t>,</p>\n"
"    <p style=\"margin: 0 0 16px;\">\n"
"        <strong t-out=\"object.request_id.user_id.name or "
"object.request_id.company_id.name or ''\">Marc</strong>\n"
"        sent you <strong t-out=\"object.request_id.name or ''\">Contract</"
"strong> to sign.\n"
"    </p>\n"
"    <t t-if=\"object.request_id.message\">\n"
"        <blockquote style=\"margin: 0 0 16px; padding: 12px 16px; "
"background: #F4F7FE; border-radius: 8px; color: #5F6674;\" t-"
"out=\"object.request_id.message or ''\" data-o-mail-quote-node=\"1\" data-o-"
"mail-quote=\"1\">Message</blockquote>\n"
"    </t>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"ctx.get('sign_url')\" style=\"background: #0E58F0; "
"color: #FFFFFF; padding: 12px 24px; border-radius: 8px; text-decoration: "
"none; font-weight: 600; display: inline-block;\">Review and sign</a>\n"
"    </p>\n"
"    <p style=\"margin: 0 0 8px; color: #5F6674; font-size: 13px;\">\n"
"        <t t-if=\"object.otp_channel != 'none'\">For your security, a one-"
"time code will be sent to you before you can open the document.</t>\n"
"        <t t-if=\"object.request_id.expire_on\"> This request is valid until "
"<t t-out=\"format_date(object.request_id.expire_on)\">2026-12-01</t>.</t>\n"
"    </p>\n"
"    <p style=\"margin: 0; color: #5F6674; font-size: 13px;\">This link is "
"personal: please do not forward this e-mail.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"font-family: Nunito, Helvetica, Arial, sans-serif; color: "
"#111827; max-width: 560px;\">\n"
"    <p style=\"margin: 0 0 16px;\">Bonjour <t t-out=\"object.name or "
"''\">Alice</t>,</p>\n"
"    <p style=\"margin: 0 0 16px;\">\n"
"        <strong t-out=\"object.request_id.user_id.name or "
"object.request_id.company_id.name or ''\">Marc</strong>\n"
"        vous a envoyé <strong t-out=\"object.request_id.name or "
"''\">Contrat</strong> à signer.\n"
"    </p>\n"
"    <t t-if=\"object.request_id.message\">\n"
"        <blockquote style=\"margin: 0 0 16px; padding: 12px 16px; "
"background: #F4F7FE; border-radius: 8px; color: #5F6674;\" t-"
"out=\"object.request_id.message or ''\" data-o-mail-quote-node=\"1\" data-o-"
"mail-quote=\"1\">Message</blockquote>\n"
"    </t>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"ctx.get('sign_url')\" style=\"background: #0E58F0; "
"color: #FFFFFF; padding: 12px 24px; border-radius: 8px; text-decoration: "
"none; font-weight: 600; display: inline-block;\">Consulter et signer</a>\n"
"    </p>\n"
"    <p style=\"margin: 0 0 8px; color: #5F6674; font-size: 13px;\">\n"
"        <t t-if=\"object.otp_channel != 'none'\">Pour votre sécurité, un "
"code à usage unique vous sera envoyé avant l'ouverture du document.</t>\n"
"        <t t-if=\"object.request_id.expire_on\"> Cette demande est valable "
"jusqu'au <t t-out=\"format_date(object.request_id.expire_on)\">2026-12-01</"
"t>.</t>\n"
"    </p>\n"
"    <p style=\"margin: 0; color: #5F6674; font-size: 13px;\">Ce lien vous "
"est personnel : merci de ne pas transférer cet e-mail.</p>\n"
"</div>\n"
"        "

#. module: sign_methode
#: model:mail.template,body_html:sign_methode.mail_template_completed
msgid ""
"<div style=\"font-family: Nunito, Helvetica, Arial, sans-serif; color: "
"#111827; max-width: 560px;\">\n"
"    <p style=\"margin: 0 0 16px;\">Hello <t t-out=\"object.name or "
"''\">Alice</t>,</p>\n"
"    <p style=\"margin: 0 0 16px;\">Every party has signed <strong t-"
"out=\"object.request_id.name or ''\">Contract</strong>. The signed document "
"is attached; it carries an electronic seal and a certificate of completion.</"
"p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"ctx.get('sign_url')\" style=\"background: #0E58F0; "
"color: #FFFFFF; padding: 12px 24px; border-radius: 8px; text-decoration: "
"none; font-weight: 600; display: inline-block;\">View the signed document</"
"a>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"font-family: Nunito, Helvetica, Arial, sans-serif; color: "
"#111827; max-width: 560px;\">\n"
"    <p style=\"margin: 0 0 16px;\">Bonjour <t t-out=\"object.name or "
"''\">Alice</t>,</p>\n"
"    <p style=\"margin: 0 0 16px;\">Toutes les parties ont signé <strong t-"
"out=\"object.request_id.name or ''\">Contrat</strong>. Vous trouverez le "
"document signé en pièce jointe ; il est revêtu d'un cachet électronique et "
"d'un certificat de réalisation.</p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"ctx.get('sign_url')\" style=\"background: #0E58F0; "
"color: #FFFFFF; padding: 12px 24px; border-radius: 8px; text-decoration: "
"none; font-weight: 600; display: inline-block;\">Consulter le document "
"signé</a>\n"
"    </p>\n"
"</div>\n"
"        "

#. module: sign_methode
#: model:mail.template,body_html:sign_methode.mail_template_otp
msgid ""
"<div style=\"font-family: Nunito, Helvetica, Arial, sans-serif; color: "
"#111827; max-width: 560px;\">\n"
"    <p style=\"margin: 0 0 16px;\">Hello <t t-out=\"object.name or "
"''\">Alice</t>,</p>\n"
"    <p style=\"margin: 0 0 16px;\">Your code to sign <strong t-"
"out=\"object.request_id.name or ''\">Contract</strong> is:</p>\n"
"    <p style=\"margin: 0 0 16px; font-size: 32px; font-weight: 700; letter-"
"spacing: 8px; color: #093DA8;\" t-out=\"ctx.get('sign_otp') or ''\">123456</"
"p>\n"
"    <p style=\"margin: 0; color: #5F6674; font-size: 13px;\">It is valid for "
"10 minutes. If you did not ask for it, ignore this e-mail.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"font-family: Nunito, Helvetica, Arial, sans-serif; color: "
"#111827; max-width: 560px;\">\n"
"    <p style=\"margin: 0 0 16px;\">Bonjour <t t-out=\"object.name or "
"''\">Alice</t>,</p>\n"
"    <p style=\"margin: 0 0 16px;\">Votre code pour signer <strong t-"
"out=\"object.request_id.name or ''\">Contrat</strong> est :</p>\n"
"    <p style=\"margin: 0 0 16px; font-size: 32px; font-weight: 700; letter-"
"spacing: 8px; color: #093DA8;\" t-out=\"ctx.get('sign_otp') or ''\">123456</"
"p>\n"
"    <p style=\"margin: 0; color: #5F6674; font-size: 13px;\">Il est valable "
"10 minutes. Si vous n'en avez pas fait la demande, ignorez cet e-mail.</p>\n"
"</div>\n"
"        "

