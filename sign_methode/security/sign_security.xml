<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_sign" model="ir.module.category">
        <field name="name">Signatures</field>
        <field name="sequence">40</field>
    </record>
    <record id="privilege_sign" model="res.groups.privilege">
        <field name="name">Signatures</field>
        <field name="category_id" ref="module_category_sign" />
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_sign" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field name="comment">Sends documents for signature and follows their own requests.</field>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_sign" />
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]" />
        <field name="comment">Sees every request, manages templates and roles.</field>
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>

    <record id="rule_request_company" model="ir.rule">
        <field name="name">Signature requests: allowed companies</field>
        <field name="model_id" ref="model_sign_methode_request" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_request_own" model="ir.rule">
        <field name="name">Signature requests: own or followed</field>
        <field name="model_id" ref="model_sign_methode_request" />
        <field name="groups" eval="[Command.link(ref('group_user'))]" />
        <field
            name="domain_force"
        >['|', ('user_id', '=', user.id), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_request_all" model="ir.rule">
        <field name="name">Signature requests: all</field>
        <field name="model_id" ref="model_sign_methode_request" />
        <field name="groups" eval="[Command.link(ref('group_manager'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_template_company" model="ir.rule">
        <field name="name">Signature templates: allowed companies</field>
        <field name="model_id" ref="model_sign_methode_template" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
