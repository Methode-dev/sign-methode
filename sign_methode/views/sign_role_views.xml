<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sign_role_view_list" model="ir.ui.view">
        <field name="name">sign.methode.role.list</field>
        <field name="model">sign.methode.role</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="color" widget="color_picker" />
                <field name="partner_expression" />
            </list>
        </field>
    </record>
    <record id="action_sign_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">sign.methode.role</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
