<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sign_template_view_form" model="ir.ui.view">
        <field name="name">sign.methode.template.form</field>
        <field name="model">sign.methode.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_editor"
                        type="object"
                        string="Place fields"
                        class="btn-primary"
                        icon="fa-pencil-square-o"
                        invisible="not id"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-paper-plane-o">
                            <field name="request_count" widget="statinfo" string="Requests" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Partnership agreement" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document" filename="document_name" />
                            <field name="document_name" invisible="1" />
                            <field name="page_count" invisible="not document" />
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="use_record_document" invisible="not model_id" />
                        </group>
                        <group>
                            <field name="sequential" />
                            <field name="otp_channel" />
                            <field name="role_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="role_id" />
                                    <field name="type" />
                                    <field name="required" />
                                    <field name="page" />
                                    <field name="x" optional="hide" />
                                    <field name="y" optional="hide" />
                                    <field name="w" optional="hide" />
                                    <field name="h" optional="hide" />
                                    <field name="placeholder" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="sign_template_view_kanban" model="ir.ui.view">
        <field name="name">sign.methode.template.kanban</field>
        <field name="model">sign.methode.template</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold" />
                        <field name="model_id" class="small text-muted" />
                        <div class="d-flex mt-2 gap-2">
                            <field name="role_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                        </div>
                        <footer class="pt-1">
                            <span class="small text-muted"><field name="page_count" /> page(s)</span>
                            <a name="action_open_editor" type="object" role="button" class="ms-auto btn btn-sm btn-secondary">Place fields</a>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sign_template_view_list" model="ir.ui.view">
        <field name="name">sign.methode.template.list</field>
        <field name="model">sign.methode.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="model_id" />
                <field name="page_count" />
                <field name="request_count" />
            </list>
        </field>
    </record>

    <record id="action_sign_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">sign.methode.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a reusable layout</p>
            <p>Upload a PDF once, drop the signature fields where they belong, and reuse it for every contract.</p>
        </field>
    </record>
</odoo>
